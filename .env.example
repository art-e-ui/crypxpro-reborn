# ==========================================
# CrypX-Pro Environment Variables Configuration
# Copy this file to .env or set these in Netlify Environment Variables
# ==========================================

# Supabase Credentials (Required for Auth & Database)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# App Metadata & Deployment Flags
VITE_APP_NAME=CrypX-Pro
VITE_APP_ENV=production
